    "superjson": "^2.2.1",
    "zod": "^3.23.8",
    "@lunchbox/auth": "*",
    "@lunchbox/db": "*",
    "@lunchbox/trpc-server": "*",
    "@lunchbox/contracts": "*"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "tsx": "^4.19.2",
    "typescript": "~5.9.2",
    "vitest": "^2.1.8"
  }
}
