# Copy to .env and adjust if needed. All defaults work with the bundled docker-compose.

# Database (Postgres in docker)
DATABASE_URL=postgresql://lunchbox:lunchbox@localhost:5433/lunchbox?schema=public

# API
API_PORT=4000
API_HOST=0.0.0.0
API_ORIGIN=http://localhost:4000

# BetterAuth
BETTER_AUTH_SECRET=dev-secret-change-me-in-production-at-least-32-chars
BETTER_AUTH_URL=http://localhost:4000

# Frontend origins (CORS)
STORE_ORIGIN=http://localhost:4100
MERCHANT_ORIGIN=http://localhost:4200
SUPPLIER_ORIGIN=http://localhost:4300
ACCOUNTING_ORIGIN=http://localhost:4400

# SMTP (local — captured by Mailpit, never leaves your machine)
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_FROM="Lunchbox <noreply@lunchbox.test>"

# Next.js apps
NEXT_PUBLIC_API_URL=http://localhost:4000
