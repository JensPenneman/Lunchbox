{
  "name": "lunchbox",
  "version": "0.0.1",
  "license": "PolyForm-Noncommercial-1.0.0",
  "private": true,
  "engines": {
    "node": ">=22"
  },
  "workspaces": [
    "apps/*",
    "libs/*"
  ],
  "scripts": {
    "dev": "nx run-many -t dev --parallel=10",
    "build": "nx run-many -t build",
    "lint": "nx run-many -t lint",
    "typecheck": "nx run-many -t typecheck",
    "test": "nx run-many -t test",
    "test:e2e": "nx run-many -t e2e",
    "db:up": "docker compose up -d db",
    "db:down": "docker compose down",
    "db:logs": "docker compose logs -f db",
    "db:reset": "docker compose down -v && docker compose up -d db && sleep 3 && npm run db:migrate && npm run db:seed",
    "db:migrate": "npm run -w @lunchbox/db migrate:dev",
    "db:generate": "npm run -w @lunchbox/db generate",
    "db:seed": "npm run -w @lunchbox/db seed",
    "db:studio": "npm run -w @lunchbox/db studio",
    "setup": "npm install && npm run db:up && sleep 3 && npm run db:generate && npm run db:migrate && npm run db:seed",
    "clean": "rm -rf node_modules apps/*/node_modules libs/*/node_modules .nx dist && npm install"
  },
  "dependencies": {},
  "devDependencies": {
    "@nx/js": "22.6.5",
    "@swc-node/register": "1.11.1",
    "@swc/core": "1.15.26",
    "@swc/helpers": "0.5.21",
    "nx": "22.6.5",
    "prettier": "^3.8.3",
    "tslib": "^2.8.1",
    "typescript": "~6.0.3"
  }
}
