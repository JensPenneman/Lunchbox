{
  "$schema": "./node_modules/nx/schemas/nx-schema.json",
  "namedInputs": {
    "default": ["{projectRoot}/**/*", "sharedGlobals"],
    "production": [
      "default",
      "!{projectRoot}/**/*.spec.ts",
      "!{projectRoot}/**/*.test.ts",
      "!{projectRoot}/**/*.e2e.ts",
      "!{projectRoot}/**/*.stories.tsx",
      "!{projectRoot}/tsconfig.spec.json"
    ],
    "sharedGlobals": [
      "{workspaceRoot}/tsconfig.base.json",
      "{workspaceRoot}/.nvmrc"
    ]
  },
  "targetDefaults": {
    "build": { "cache": true, "dependsOn": ["^build"], "inputs": ["production", "^production"] },
    "typecheck": { "cache": true, "dependsOn": ["^build"] },
    "lint": { "cache": true },
    "test": { "cache": true, "dependsOn": ["^build"] },
    "e2e": { "cache": false, "dependsOn": ["^build"] },
    "dev": { "cache": false, "dependsOn": ["^build"] }
  },
  "analytics": false
}
